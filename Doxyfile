# Doxygen configuration for SSD1315
# Generated and maintained for unified API documentation.

PROJECT_NAME           = "SSD1315"
PROJECT_NUMBER         = "4.0.2"
PROJECT_BRIEF          = "SSD1315 embedded library API documentation"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English
INPUT_ENCODING         = UTF-8

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO

SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
STRIP_CODE_COMMENTS    = NO

INPUT                  = README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md include docs
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
EXCLUDE                = docs/doxygen docs/extracted-md docs/pdf-extracted-md docs/reports
EXCLUDE_PATTERNS       = */.pio/* */.git/* */test/* */docs/doxygen/* */docs/extracted-md/* */docs/pdf-extracted-md/* */docs/reports/*
EXAMPLE_PATH           = examples/01_basic_bringup_cli

USE_MDFILE_AS_MAINPAGE = README.md
FULL_PATH_NAMES        = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = NO
