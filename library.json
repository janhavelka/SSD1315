{
  "name": "SSD1315",
  "version": "2.1.0",
  "description": "Hardened SSD1315 I2C OLED display driver for ESP32. Tick-budgeted flushing, partial updates, page buffer mode, hardware scroll support.",
  "keywords": [
    "esp32",
    "esp32-s2",
    "esp32-s3",
    "arduino",
    "esp-idf",
    "platformio",
    "oled",
    "ssd1315",
    "i2c",
    "display",
    "embedded",
    "non-blocking"
  ],
  "authors": [
    {
      "name": "Jan Havelka",
      "email": "jan@havelka.dev",
      "url": "https://github.com/janhavelka",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janhavelka/SSD1315.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/janhavelka/SSD1315",
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "platforms": [
    "espressif32"
  ],
  "headers": [
    "SSD1315.h",
    "ssd1315/SSD1315.h"
  ],
  "build": {
    "includeDir": "include",
    "srcDir": "src"
  },
  "export": {
    "include": [
      "library.json",
      "README.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "SECURITY.md",
      "Doxyfile",
      "platformio.ini",
      "CMakeLists.txt",
      "idf_component.yml",
      "include/**",
      "src/**",
      "examples/01_basic_bringup_cli/**",
      "examples/common/**",
      "examples/espidf_basic/**",
      "scripts/generate_version.py",
      "tools/*.py",
      "docs/*.md",
      "docs/*.pdf",
      "docs/extracted-md/*.md",
      "docs/pdf-extracted-md/*.md"
    ]
  }
}
